{
	"schemaVersion": 1,
	"id": "creaturechat",
	"version": "${version}",
	"name": "CreatureVoice",
	"description": "Speak directly to Minecraft mobs and hear them talk back. Full voice pipeline: hold V to speak, mobs respond with unique AI voices in 3D positional audio.",
	"authors": [
		"bmo2003"
	],
	"contact": {
		"homepage": "https://github.com/bmo2003/CreatureVoice",
		"sources": "https://github.com/bmo2003/CreatureVoice",
		"issues": "https://github.com/bmo2003/CreatureVoice/issues"
	},
	"license": "GPLv3",
	"icon": "assets/creaturechat/icon.png",
	"environment": "*",
    "entrypoints": {
        "main": [
          "com.owlmaddie.ModInit"
        ],
        "client": [
          "com.owlmaddie.ClientInit"
        ],
        "fabric-datagen": [
          "com.owlmaddie.datagen.CreatureChatDataGenerator"
        ],
        "modmenu": [
          "com.owlmaddie.config.ModMenuIntegration"
        ]
    },
	"mixins": [
		"creaturechat.mixins.json",
		{
			"config": "creaturechat.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "creaturechat.accesswidener",
	"depends": {
		"fabricloader": ">=0.14.22",
		"minecraft": "~1.21.7",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": ">=15"
	}
}
